# Boom Bazaar Environment Configuration
# Copy this file to .env.local for local overrides

# Cloudflare D1 Database Configuration (Production)
CLOUDFLARE_DATABASE_NAME=boom_bazaar
CLOUDFLARE_DATABASE_ID=68376693-77c8-489e-9b66-349baf8b8755

# Optional: If deploying to Vercel/Node and connecting directly to remote Cloudflare D1 over HTTPS:
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Security Secret for Admin Session JWT
JWT_SECRET=your-secure-random-jwt-secret-key-at-least-32-chars-long

# Storefront WhatsApp Hotline Configuration
NEXT_PUBLIC_APP_NAME="Boom Bazaar"
NEXT_PUBLIC_WHATSAPP_PHONE="8128627017"
